# Environment Mode
NODE_ENV=development

# Core API Config
API_PORT=3001
API_URL=http://localhost:3001

# AI Service Microservice Config
AI_SERVICE_URL=http://localhost:8000

# Database & Supabase Config
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cv_ats_db
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis Queue Config
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# LLM Provider Configuration (Groq Llama 3.1 8B Instant)
LLM_PROVIDER=groq
LLM_API_KEY=API_KEY_FOR_GROQ_LLM_PROVIDER
LLM_MODEL=llama-3.1-8b-instant

# Embedding Model Config
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Security & Upload Policies
JWT_SECRET=super-secret-jwt-key-change-in-production
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_SIZE_MB=10
